{
  "expo": {
    "name": "TV Streaming Frontend",
    "slug": "tv-streaming-frontend",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.local.tvstreaming",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
